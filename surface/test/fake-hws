#!/bin/bash
# Stands in for the hws CLI. Logs each call and answers per the contract.
# FAKE_HWS_DIR      where the log and moved bundles go
# FAKE_HWS_MODE     glued (default), standalone, or failing
# FAKE_HWS_CLOSE    when 1, a glued Done or a pop hangs up the host first, as closing its pane would
log="$FAKE_HWS_DIR/hws.log"
mkdir -p "$FAKE_HWS_DIR"
echo "$*" >> "$log"
case "$1 $2" in
  "surface done")
    bundle=""
    while [[ $# -gt 0 ]]; do
      [[ "$1" == "--bundle" ]] && bundle="$2"
      shift
    done
    n=$(ls "$FAKE_HWS_DIR/artifacts" 2>/dev/null | wc -l | tr -d ' ')
    art="a$n"
    mkdir -p "$FAKE_HWS_DIR/artifacts"
    if [[ "$FAKE_HWS_MODE" == "failing" ]]; then
      echo '{"error":"the artifact store is full"}'
      exit 1
    fi
    mv "$bundle" "$FAKE_HWS_DIR/artifacts/$art"
    if [[ "$FAKE_HWS_MODE" == "standalone" ]]; then
      echo "{\"standalone\":true,\"artifact\":\"$art\",\"link\":\"@$FAKE_HWS_DIR/artifacts/$art/prompt.md\"}"
    else
      if [[ "$FAKE_HWS_CLOSE" == "1" ]]; then
        kill -HUP "$PPID" 2>/dev/null
        sleep 1
        echo "survived host hangup" >> "$log"
      fi
      echo "{\"artifact\":\"$art\"}"
    fi
    ;;
  "surface pop")
    id=""
    to=""
    while [[ $# -gt 0 ]]; do
      [[ "$1" == "--id" ]] && id="$2"
      [[ "$1" == "--to" ]] && to="$2"
      shift
    done
    if [[ "$FAKE_HWS_MODE" == "failing" ]]; then
      echo '{"error":"the surface has no open pane"}'
      exit 1
    fi
    if [[ "$FAKE_HWS_CLOSE" == "1" ]]; then
      kill -HUP "$PPID" 2>/dev/null
      sleep 1
      echo "survived host hangup" >> "$log"
    fi
    echo "{\"id\":\"$id\",\"shown\":\"$to\",\"moved\":true}"
    ;;
  "surface targets")
    echo '{"current":"standalone","suggested":"w1","workspaces":[{"id":"w1","name":"herdr-workspaces","kind":"app"},{"id":"w2","name":"herdr-walkthrough","kind":"general"}]}'
    ;;
  "surface move")
    if [[ "$FAKE_HWS_MODE" == "failing" ]]; then
      echo '{"error":"that workspace is archived"}'
      exit 1
    fi
    echo '{"moved":true}'
    ;;
  "link "*)
    echo "{\"link\":\"@$FAKE_HWS_DIR/artifacts/$2/prompt.md\"}"
    ;;
  "artifact terminal")
    echo '{"ok":true}'
    ;;
  *)
    echo '{}'
    ;;
esac
